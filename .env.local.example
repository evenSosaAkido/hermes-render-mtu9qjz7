# Local run config for scripts/run-local.sh
#
# Copy this file to `.env.local` (which is gitignored) and fill in what you
# need:  cp .env.local.example .env.local
#
# This is SEPARATE from `.env.example`, which documents the Render *deploy*
# env vars. This file only configures the local Docker run helper.
#
# Everything here is optional. The script has sensible defaults, and any
# value you export in your shell overrides the value set here.

# --- Render MCP -------------------------------------------------------------
# Enables the bundled Render MCP tools. Get one at:
#   https://dashboard.render.com/u/*/settings#api-keys
# Leave blank to run without Render tools.
RENDER_MCP_API_KEY=

# --- Amazon Bedrock ---------------------------------------------------------
# Set USE_BEDROCK=1 to have the script pull your AWS credentials via
# `aws configure export-credentials` and inject them into the container.
# No need to paste keys here — just point at the right profile/region.
# For AWS SSO profiles, run `aws sso login` first so a session exists.
USE_BEDROCK=0
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# --- Container / run options ------------------------------------------------
# IMAGE=hermes-render
# PORT=10000
# DATA_DIR=./hermes-data
# BUILD=0
